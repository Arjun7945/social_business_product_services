
application {
  config {
    baseName whatsappProductService
    applicationType monolith
    packageName com.aps
    authenticationType jwt
    databaseType sql
    devDatabaseType postgresql
    prodDatabaseType postgresql
    cacheProvider hazelcast
    enableHibernateCache true
    buildTool maven
    clientFramework angular
    testFrameworks [cucumber, cypress]
    // enableOpenapiGenerator true
    serverPort 8081
    serviceDiscoveryType no
    nativeLanguage en
    languages [en, ar-ly, nl, fr, de, el, hi, mr, pa, ru, es, ta, te]
  }
  entities *
}

/**
 * Customer entity representing the end-user.
 * Stores WhatsApp details, location, and flow state.
 * Refactored: Removed temp fields, added address.
 */
entity Customer {
    waPhoneNumber String required unique
    name String
    phoneNumber String
    locationLat Double
    locationLon Double
    address String // Optional address field as requested
    distanceFromBusinessKm Double
    isPincodeValid Boolean required
    role UserRole required
    joinedAt Instant
    lastInteractionAt Instant
}

/**
 * Product catalog entity.
 * Indexed in Elasticsearch for fast search.
 */
entity FishProduct {
    name String required
    pricePerKg BigDecimal required min(0)
    imageUrl String
    description String maxlength(2000) /** Increased length for SEO descriptions */
    isAvailable Boolean required
    createdAt Instant
}

/**
 * Images associated with a product.
 */
entity ProductImage {
    imageUrl String required
    displayOrder Integer required
}

/**
 * Main Order entity.
 * Renamed to CustomerOrder to avoid SQL keyword conflicts.
 */
entity CustomerOrder {
    orderTime Instant required
    totalAmount BigDecimal required min(0)
    status OrderStatus required
    paymentMethod String required
    confirmedAt Instant
}

/**
 * Individual items within an order.
 */
entity OrderItem {
    quantityKg Double required min(0.1) /** Quantity remains Double as weight can be fractional */
    priceAtOrder BigDecimal required min(0)
}

/**
 * Persistent Shopping Cart for a customer.
 */
entity ShoppingCart {
    createdAt Instant required
    updatedAt Instant
}

/**
 * Items currently in the shopping cart.
 */
entity CartItem {
    quantityKg Double required
    addedAt Instant
}

/**
 * Internal Team Members (Admins, Executives, Delivery).
 * Refactored: Removed all temp_ fields.
 */
entity TeamMember {
    name String required
    waPhoneNumber String unique
    phoneNumber String required unique
    role UserRole required
    isActive Boolean required
}

/**
 * NEW ENTITY: BotSession
 * Manages the conversation state and temporary data (scratchpad).
 * Replaces all temp_ variables in main entities.
 */
entity BotSession {
    waPhoneNumber String required unique /** Key to link to Customer or TeamMember */
    currentState String required /** Checkpoints the user's flow (e.g., AWAITING_NAME) */
    sessionData TextBlob /** JSON blob to store temp variables like { "tempProductId": 123, "tempName": "John" } */
    lastActiveAt Instant
}


// Enums
enum UserRole {
    CUSTOMER,
    EXECUTIVE,
    DELIVERY_PERSON,
    ASSISTANT_ADMIN,
    ADMIN,
    DEVELOPER
}

enum OrderStatus {
    PENDING,
    CONFIRMED,
    DELIVERED,
    CANCELLED
}

enum CustomerFlowStage {
    NEW,
    AWAITING_NAME,
    AWAITING_PHONE,
    AWAITING_LOCATION,
    REGISTERED,
    BROWSING,
    ADDING_TO_CART,
    AWAITING_QUANTITY,
    CHECKOUT,
    CONFIRMING_ORDER,
    EDITING_ORDER,
    EDITING_PRODUCT,
    EDITING_QUANTITY
}

enum ExecutiveFlowStage {
    IDLE,
    AWAITING_CUST_NAME,
    AWAITING_CUST_PHONE,
    AWAITING_CUST_WAPHONE,
    AWAITING_CUST_LOCATION
}

enum AdminFlowStage {
    IDLE,
    CUSTOMER_MENU,
    AWAITING_CUST_NAME,
    AWAITING_CUST_PHONE,
    AWAITING_CUST_LOCATION,
    DELIVERY_MENU,
    PRODUCT_MENU,
    AWAITING_PRODUCT_PRICE
}

// Relationships
relationship OneToMany {
    /** One Customer has many Orders */
    Customer{orders} to CustomerOrder{customer(name) required}

    /** One Product has many Images */
    FishProduct{images} to ProductImage{product(name) required}

    /** One Order has many OrderItems */
    CustomerOrder{items} to OrderItem{order(id) required}
    
    /** One ShoppingCart has many CartItems */
    ShoppingCart{items} to CartItem{cart(id) required}

    /** One Customer has one Shopping Cart */
    Customer{cart} to ShoppingCart{customer(name) required}
}

relationship ManyToOne {
    /** OrderItem links to a Product (Snapshot needed? usually yes but simple link here) */
    OrderItem{product(name) required} to FishProduct

    /** CartItem links to a Product */
    CartItem{product(name) required} to FishProduct

    /** TeamMember (Executive) who added the Customer */
    Customer{addedBy(name)} to TeamMember

    /** TeamMember (Delivery) assigned to Order */
    CustomerOrder{deliveryPerson(name)} to TeamMember
}


// Options
paginate Customer, CustomerOrder, OrderItem, FishProduct, ProductImage, ShoppingCart, CartItem, TeamMember, BotSession with pagination
service all with serviceClass
dto all with mapstruct
filter Customer, CustomerOrder, OrderItem, FishProduct, ShoppingCart, CartItem, TeamMember, BotSession

