<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Customer.
    -->
    <changeSet id="20251228084005-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="added_by_id"
                                 baseTableName="customer"
                                 constraintName="fk_customer__added_by_id"
                                 referencedColumnNames="id"
                                 referencedTableName="team_member"
                                 />

        <addForeignKeyConstraint baseColumnNames="zone_id"
                                 baseTableName="customer"
                                 constraintName="fk_customer__zone_id"
                                 referencedColumnNames="id"
                                 referencedTableName="delivery_zone"
                                 />
    </changeSet>
</databaseChangeLog>
