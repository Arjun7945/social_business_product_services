    <!--
        Added the constraints for entity ReturnedOrder.
    -->
    <changeSet id="20251228084018-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="order_id"
                                 baseTableName="returned_order"
                                 constraintName="fk_returned_order__order_id"
