{
  "annotations": {
    "changelogDate": "20251215140326"
  },
  "applications": ["whatsappProductService"],
  "documentation": "Main Order entity.\\nRenamed to CustomerOrder to avoid SQL keyword conflicts.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "orderTime",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "totalAmount",
      "fieldType": "BigDecimal",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "fieldName": "status",
      "fieldType": "OrderStatus",
      "fieldValidateRules": ["required"],
      "fieldValues": "PENDING,CONFIRMED,DELIVERED,CANCELLED"
    },
    {
      "fieldName": "paymentMethod",
      "fieldType": "String",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "confirmedAt",
      "fieldType": "Instant"
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "CustomerOrder",
  "pagination": "pagination",
  "relationships": [
    {
      "documentation": "One Order has many OrderItems",
      "otherEntityName": "orderItem",
      "otherEntityRelationshipName": "order",
      "relationshipName": "items",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "documentation": "TeamMember (Delivery) assigned to Order",
      "otherEntityField": "name",
      "otherEntityName": "teamMember",
      "relationshipName": "deliveryPerson",
      "relationshipSide": "left",
      "relationshipType": "many-to-one"
    },
    {
      "otherEntityField": "name",
      "otherEntityName": "customer",
      "otherEntityRelationshipName": "orders",
      "relationshipName": "customer",
      "relationshipSide": "right",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
