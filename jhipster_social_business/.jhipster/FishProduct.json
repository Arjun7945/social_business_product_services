{
  "annotations": {
    "changelogDate": "20251228084008"
  },
  "applications": ["whatsappProductServicePro"],
  "documentation": "Product catalog entity.\\nIndexed in Elasticsearch for fast search.\\nUPDATED: 'imageUrl' removed in favor of ProductImage entity relation.",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "name",
      "fieldType": "String",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "pricePerKg",
      "fieldType": "BigDecimal",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "0"
    },
    {
      "documentation": "To track available stock",
      "fieldName": "availableQuantity",
      "fieldType": "Double"
    },
    {
      "fieldName": "description",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "2000"
    },
    {
      "fieldName": "isAvailable",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "createdAt",
      "fieldType": "Instant"
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "FishProduct",
  "pagination": "pagination",
  "relationships": [
    {
      "documentation": "One Product has exactly One Image",
      "otherEntityName": "productImage",
      "otherEntityRelationshipName": "product",
      "relationshipName": "image",
      "relationshipSide": "left",
      "relationshipType": "one-to-one"
    }
  ],
  "searchEngine": "no",
  "service": "serviceClass"
}
