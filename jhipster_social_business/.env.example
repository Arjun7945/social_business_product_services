# Application Secrets
# COPY THIS FILE TO .env AND FILL IN REAL VALUES

# Licensing
LICENSE_SERVER_URL=https://api.myapp.com/verify
LICENSE_KEY=your-license-key-here
LICENSE_CRON="0 0 12 * * ?" # Daily at noon

# WhatsApp Configuration
WHATSAPP_TOKEN=your-meta-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Database (Optional overrides)
# DB_URL=jdbc:postgresql://localhost:5432/whatsappproductservicepro
# DB_USERNAME=whatsappproductservicepro
# DB_PASSWORD=your-db-password
